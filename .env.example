# Copy to .env and adjust. Never commit secrets.

# Public hostname served by Caddy (Let's Encrypt certificates are issued for it).
SITE_ADDRESS=argonaut.skymaps.info
ACME_EMAIL=your-email@example.com

# Container image tag to run. The default builds it in place from docker/Dockerfile.
MAP3D_IMAGE=map3d:latest

# dustmaps git ref (branch, tag or commit SHA).
DUSTMAPS_REF=master

# Host directory holding the dust maps and derived stamp images (EBS volume).
# This and MAP3D_DATA_MODE are read by compose itself, so set them in the shell
# (or in docker/.env) rather than only here: MAP3D_DATA_MODE=rw for maintenance
# runs that write to the volume, and back to ro for serving.
MAP3D_DATA_HOST_DIR=/srv/map3d/data

MAP3D_LOG_LEVEL=INFO
